PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hlsxcs
DB_USER=hluser
DB_PASSWORD=替换为你自己的MySQL密码
TOKEN_SECRET=替换为一段足够长的随机密钥
BOOTSTRAP_SECRET=替换为至少32位随机字符串，仅首次初始化管理员时使用
# Cloudflare R2 (keep credentials on the server; never commit real values)
R2_ACCOUNT_ID=替换为你的Cloudflare账户ID
R2_BUCKET=workcloudr2
R2_ACCESS_KEY_ID=替换为你的R2访问密钥ID
R2_SECRET_ACCESS_KEY=替换为你的R2秘密访问密钥
R2_ENDPOINT=https://替换为你的Cloudflare账户ID.r2.cloudflarestorage.com
